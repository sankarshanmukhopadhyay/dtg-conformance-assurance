{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dcas/schemas/dcas-evaluation-result.schema.json",
  "title": "DCAS Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evaluation_id", "decision", "evaluator", "findings", "evidence_summary", "receipt_material"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PASS", "FAIL", "INDETERMINATE"]},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "result", "reason"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "INDETERMINATE", "NOT_APPLICABLE"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumed", "missing", "rejected"],
      "properties": {
        "consumed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rejected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed": {"type": "string"},
        "supported": {"type": "string"}
      }
    },
    "receipt_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_digest", "result_digest_algorithm"],
      "properties": {
        "input_digest": {"type": "string", "minLength": 1},
        "result_digest_algorithm": {"enum": ["sha256"]}
      }
    }
  }
}
