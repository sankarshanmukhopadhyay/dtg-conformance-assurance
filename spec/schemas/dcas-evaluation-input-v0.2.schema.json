{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/dtg-conformance-assurance/main/spec/schemas/dcas-evaluation-input-v0.2.schema.json",
  "title": "DCAS Evaluation Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evaluation_id",
    "target",
    "claim",
    "evidence",
    "policy",
    "evaluation_time"
  ],
  "properties": {
    "contract_version": {
      "const": "0.2"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "version",
        "profile"
      ],
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "requirements",
        "requirement_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requirement_evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "requires_action_authority": {
          "type": "boolean"
        },
        "assurance_overclaim": {
          "type": "boolean"
        },
        "source_context": {
          "type": "object"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "missing",
              "unverifiable",
              "stale",
              "revoked",
              "contradicted"
            ]
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_evidence"
      ],
      "properties": {
        "missing_evidence": {
          "const": "INDETERMINATE"
        },
        "authority_inference_from_identity": {
          "const": false
        },
        "stale_evidence": {
          "enum": [
            "FAIL",
            "INDETERMINATE"
          ]
        },
        "revoked_evidence": {
          "enum": [
            "FAIL",
            "INDETERMINATE"
          ]
        },
        "authority_absent": {
          "enum": [
            "FAIL",
            "INDETERMINATE"
          ]
        },
        "assurance_overclaim": {
          "enum": [
            "FAIL",
            "INDETERMINATE"
          ]
        }
      }
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
