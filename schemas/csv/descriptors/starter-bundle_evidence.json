{
  "id": "starter-bundle.evidence",
  "title": "Evidence CSV schema",
  "applies_to": "templates/starter-bundle/evidence.csv",
  "columns": [
    {
      "name": "evidence_id",
      "required": true,
      "type": "string"
    },
    {
      "name": "title",
      "required": true,
      "type": "string"
    },
    {
      "name": "description",
      "required": true,
      "type": "string"
    },
    {
      "name": "artifact_path",
      "required": true,
      "type": "string"
    },
    {
      "name": "artifact_type",
      "required": true,
      "type": "string"
    },
    {
      "name": "created_at",
      "required": true,
      "type": "datetime"
    },
    {
      "name": "owner",
      "required": true,
      "type": "string"
    },
    {
      "name": "control_objective_ids",
      "required": true,
      "type": "id_list",
      "delimiter": ";"
    },
    {
      "name": "uri",
      "required": false,
      "type": "string"
    },
    {
      "name": "hash",
      "required": false,
      "type": "string"
    }
  ],
  "allow_extensions": true,
  "extension_prefix": "x_"
}
