{
  "id": "starter-bundle.evaluation_results",
  "title": "Evaluation results CSV schema",
  "applies_to": "templates/starter-bundle/evaluation_results.csv",
  "columns": [
    {
      "name": "check_id",
      "required": true,
      "type": "string"
    },
    {
      "name": "profile_id",
      "required": true,
      "type": "string"
    },
    {
      "name": "assurance_level",
      "required": true,
      "type": "enum",
      "enum": [
        "AL1",
        "AL2",
        "AL3",
        "AL4"
      ]
    },
    {
      "name": "result",
      "required": true,
      "type": "enum",
      "enum": [
        "fail",
        "na",
        "partial",
        "pass",
        "warn"
      ]
    },
    {
      "name": "evidence_ids",
      "required": true,
      "type": "id_list",
      "delimiter": ";"
    },
    {
      "name": "checked_at",
      "required": true,
      "type": "datetime"
    },
    {
      "name": "checker",
      "required": true,
      "type": "string"
    },
    {
      "name": "notes",
      "required": false,
      "type": "string"
    }
  ],
  "allow_extensions": true,
  "extension_prefix": "x_"
}
